{
  "name": "video-manager-remotion",
  "private": true,
  "description": "VideoManager の制作案を Remotion で書き出す（public_docs/remotion_tables.md）",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "node scripts/render.mjs",
    "bundle": "remotion bundle src/index.ts --out-dir=build --public-path=/remotion-studio/ --disable-git-source --disable-ask-ai",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
